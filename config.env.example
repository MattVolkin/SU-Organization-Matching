# Copy this file to config.env and fill in real values.
# config.env is gitignored -- NEVER commit real secrets.
# Format: KEY=VALUE, one per line, no quotes, no surrounding spaces (shared by build_and_run.sh and build_and_run.bat).

# Port the server listens on. Defaults to 8080 when unset.
PORT=8080

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback
GOOGLE_INTEGRATION_TRIGGER_URL=https://integrations.googleapis.com/v2/projects/PROJECT/locations/REGION/integrations/INTEGRATION:execute?triggerId=api_trigger/sendEmail
# Path to the Google service account key (keep it out of git; server/adc_cred.json is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc_cred.json
GOOGLE_INTEGRATION_AUTH_MODE=adc
DATABASE_DSN=host=localhost port=5432 user=dev_user password=CHANGE_ME dbname=dev_project_db

# Set to true only on dev/test servers to expose /api/test/* (role switching, question bank replacement).
ENABLE_TEST_ENDPOINTS=false
